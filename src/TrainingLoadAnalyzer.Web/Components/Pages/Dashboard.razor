@page "/"
@rendermode InteractiveServer
@inject DashboardReader Reader

<PageTitle>Training Load</PageTitle>

<h1>Training Load</h1>

@if (view is null)
{
    <p class="loading">Reading your training history…</p>
}
else if (view.IsUnavailable)
{
    @* The edge case: the stored data could not be read. The athlete is told, rather than shown a
       stack trace or a page of zeroes (C87). *@
    <section class="empty">
        <h2>Data unavailable</h2>
        <p>Your stored training history could not be read. Nothing has been lost — try again, and
           if it persists, the application log says why.</p>
    </section>
}
else if (!view.HasActivities)
{
    <section class="empty">
        <h2>No activities recorded</h2>

        @if (view.IsStravaConnected)
        {
            <p>Your Strava account is connected, but nothing has been imported yet.
               Sync to bring your training in.</p>
        }
        else
        {
            <p>Connect your Strava account to bring your training in.</p>
            <a class="connect" href="/connect">Connect Strava</a>
        }
    </section>
}
else
{
    <section class="status">
        <MetricTile Label="Fitness"
                    Value="view.Current?.Fitness"
                    Basis="view.Current?.FitnessBasis ?? LoadBasis.None"
                    IsReliable="view.Current?.IsReliable ?? false" />
        <MetricTile Label="Fatigue"
                    Value="view.Current?.Fatigue"
                    Basis="view.Current?.FatigueBasis ?? LoadBasis.None"
                    IsReliable="view.Current?.IsReliable ?? false" />
        <MetricTile Label="Form"
                    Value="view.Current?.Form"
                    Basis="view.Current?.FormBasis ?? LoadBasis.None"
                    IsReliable="view.Current?.IsReliable ?? false" />
    </section>

    <section class="week">
        <WeeklyLoadPanel Week="view.CurrentWeek" Trend="view.Trend" />
    </section>

    <section class="trends">
        <MetricsChartView Metrics="view.Metrics" HasEnoughHistory="view.HasEnoughHistoryForChart" />
    </section>

    <section class="activities">
        <RecentActivityList Activities="view.Recent" />
    </section>
}

@code {
    private DashboardView? view;

    protected override async Task OnInitializedAsync() =>
        view = await Reader.ReadAsync(CancellationToken.None);
}
