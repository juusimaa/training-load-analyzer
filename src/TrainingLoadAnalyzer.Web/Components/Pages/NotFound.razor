@page "/not-found"
@layout MainLayout

<PageTitle>Not found</PageTitle>

@* 008 FR-010: the same visual language as everything else, so a wrong address does not land the
   athlete on a page that looks like it belongs to a different application. *@

<main class="page">
    <h1>Not Found</h1>

    <div class="state">
        <p>Sorry, the content you are looking for does not exist.</p>
    </div>
</main>
