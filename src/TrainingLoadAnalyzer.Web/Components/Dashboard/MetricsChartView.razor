@* Fitness, fatigue and form over the last 180 days (FR-006, SC-003).

   007 Amendment 1: the plot is MudChart's, not this project's. The consequences are recorded in the
   specification and are real - the three series no longer carry dash patterns, because MudChart
   draws every series with a solid stroke and offers no dash option, so a series is identified by
   the legend and hover label rather than by the shape of its line (007 FR-013a). The geometry this
   component used to compute itself went with it. *@

<MudPaper Class="chart" Elevation="1">
    @if (!HasEnoughHistory)
    {
        <MudText Typo="Typo.body1" Class="chart-empty">Not enough data to show trends (30+ days required)</MudText>
    }
    else
    {
        <MudChart T="double"
                  ChartType="ChartType.Line"
                  ChartSeries="@Series"
                  ChartOptions="@Options"
                  Width="100%"
                  Height="240px" />

        <MudText Typo="Typo.caption" Class="chart-span">
            @Display.Day(Metrics[0].Day) — @Display.Day(Metrics[^1].Day)
        </MudText>
    }
</MudPaper>

@code {
    /// <summary>The metrics series, at most 180 days ending today (C83).</summary>
    [Parameter] public IReadOnlyList<DailyTrainingMetrics> Metrics { get; set; } = [];

    /// <summary>False under 30 days, when a chart would mislead more than it showed (US3 sc2).</summary>
    [Parameter] public bool HasEnoughHistory { get; set; }

    /// <summary>
    ///   Which palette the plot draws with. Cascaded from <c>MainLayout</c>, which owns the theme
    ///   provider and is the only place that knows the active scheme (007 research R5).
    /// </summary>
    [CascadingParameter(Name = "IsDarkMode")] private bool IsDarkMode { get; set; }

    /// <summary>
    ///   The series names are load-bearing, not decoration: MudChart derives its legend from them,
    ///   and since Amendment 1 the legend is the only thing that tells one line from another
    ///   (007 FR-013a, FR-002).
    /// </summary>
    private List<ChartSeries<double>> Series =>
    [
        new() { Name = "Fitness", Data = new ChartData<double>([.. Metrics.Select(m => m.Fitness)]) },
        new() { Name = "Fatigue", Data = new ChartData<double>([.. Metrics.Select(m => m.Fatigue)]) },
        new() { Name = "Form", Data = new ChartData<double>([.. Metrics.Select(m => m.Form)]) },
    ];

    /// <summary>
    ///   The palette is positional - MudChart matches colour to series by index - so its order and
    ///   <see cref="Series"/>' order are the same fact written twice and must not drift.
    /// </summary>
    private ChartOptions Options => new() { ChartPalette = ChartPalette.For(IsDarkMode) };
}
