@* Daily load and the three metrics over the selected window (008 FR-005, FR-006).

   Hand-drawn again. Feature 007's Amendment 1 handed the plot to MudChart and recorded what that
   cost: the three series lost their dash patterns, because that component draws every series with
   a solid stroke, so a line could only be identified by the legend (007 FR-013a). Drawing it here
   restores the dash patterns and the exact interpolation, and adds the bars, the zero rule and the
   date axis the reference design has.

   No stroke or fill is written into this markup. Every one resolves from a class in the scoped
   stylesheet, so the plot follows the appearance the device is set to — a presentation attribute
   could not (008 research R5). *@

<section class="chart">
    <div class="chart-head">
        <h2>Daily load and metrics · last @WindowDays days</h2>

        @* The legend names every series. Since feature 006 it has been the answer to "which line
           is which"; the dash patterns now answer it a second way (SC-007, Amendment 1(c)). *@
        <div class="legend">
            <span class="legend-fitness">Fitness</span>
            <span class="legend-fatigue">Fatigue</span>
            <span class="legend-form">Form</span>
        </div>
    </div>

    @if (!HasEnoughHistory)
    {
        <p class="chart-empty">Not enough data to show trends (30+ days required)</p>
    }
    else
    {
        <div class="plot-frame">
            <svg class="plot"
                 viewBox="@MetricsChart.ViewBox(Width, Height)"
                 preserveAspectRatio="none"
                 role="img"
                 aria-label="Daily training load with fitness, fatigue and form">
                @* Back to front: the bars are a backdrop, the rule a reference, the lines the message. *@
                <g class="bars">
                    @foreach (var bar in MetricsChart.LoadBars(DailyLoad, Width, Height))
                    {
                        <rect class="load-bar" x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" />
                    }
                </g>

                @if (MetricsChart.ZeroRule(Metrics, Width, Height) is { } zero)
                {
                    <line class="zero-rule"
                          x1="0"
                          y1="@zero"
                          x2="@PlotWidth"
                          y2="@zero"
                          vector-effect="non-scaling-stroke" />
                }

                @* Reversed, so Fitness is painted last and sits on top of the other two. *@
                @foreach (var series in MetricsChart.Plot(Metrics, Width, Height).Reverse())
                {
                    <polyline class="@series.CssClass"
                              fill="none"
                              points="@series.Points"
                              vector-effect="non-scaling-stroke" />
                }
            </svg>

            @* The hover readout (008 Amendment 3).

               HTML laid over the plot, not text inside it. The svg is stretched with
               preserveAspectRatio="none" so that it fills its column, which stretches anything drawn
               inside it — an SVG readout would render horizontally distorted at every width but one.

               Every slot is in the document from the first render and revealed by CSS on :hover. That
               is not a shortcut: a Blazor event handler would cost a server round-trip per mouse
               movement on this circuit, and a script would reintroduce the client JavaScript this
               feature removed (research R3, R5). *@
            <div class="hover-layer">
                @{
                    var slots = MetricsChart.HoverSlots(Metrics, DailyLoad);
                }

                @for (var index = 0; index < slots.Count; index++)
                {
                    var slot = slots[index];

                    @* Past the middle of the plot the readout opens to the left instead, so it does
                       not run off the edge of the column. Decided from the slot's position, because
                       CSS cannot branch on an inline offset. *@
                    var opensLeft = index > slots.Count * 0.55;

                    <div class="day" style="left:@(slot.Left)%;width:@(slot.Width)%">
                        @if (slot.BarTop is { } barTop)
                        {
                            <i class="bar-focus" style="top:@(barTop)%;height:@(slot.BarHeight)%"></i>
                        }

                        <i class="guide"></i>

                        @foreach (var point in slot.Points)
                        {
                            <i class="point @point.CssClass" style="top:@(point.Top)%"></i>
                        }

                        <div class="readout @(opensLeft ? "opens-left" : "")">
                            <span class="readout-day">@slot.Day</span>

                            @foreach (var point in slot.Points)
                            {
                                <span class="readout-label legend-@(point.Label.ToLowerInvariant())">@point.Label</span>
                                <span class="readout-value">@point.Value</span>
                            }

                            @if (slot.Load is { } load)
                            {
                                <span class="readout-label">Load</span>
                                <span class="readout-value">@load</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="chart-axis">
            @foreach (var tick in MetricsChart.AxisTicks(Metrics, AxisTickCount))
            {
                <span>@tick</span>
            }
        </div>
    }
</section>

@code {
    /// <summary>The plot's coordinate space. Only the ratio matters; it scales to its container.</summary>
    private const double Width = 1000;

    private const double Height = 300;

    /// <summary>Enough labels to read the span without crowding them at a phone's width.</summary>
    private const int AxisTickCount = 6;

    /// <summary>
    ///   The plot's width as it reaches the markup, formatted once and invariantly. A double
    ///   interpolated into an attribute is formatted with the <em>current</em> culture, which is
    ///   the failure MetricsChart exists to prevent arriving through a different door.
    /// </summary>
    private static readonly string PlotWidth = Width.ToString(CultureInfo.InvariantCulture);

    /// <summary>The metrics to plot, already sliced to the selected window by the page.</summary>
    [Parameter] public IReadOnlyList<DailyTrainingMetrics> Metrics { get; set; } = [];

    /// <summary>The daily load behind them, aligned day for day (008 Amendment 2).</summary>
    [Parameter] public IReadOnlyList<DailyTrainingLoad> DailyLoad { get; set; } = [];

    /// <summary>
    ///   False under 30 days of stored history, when a chart would mislead more than it showed
    ///   (US3 sc2). A property of the history, never of the chosen window (008 research R6).
    /// </summary>
    [Parameter] public bool HasEnoughHistory { get; set; }

    /// <summary>The window the heading names, so it cannot disagree with what is drawn.</summary>
    [Parameter] public int WindowDays { get; set; }
}
