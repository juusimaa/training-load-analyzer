@* The most recent sessions, newest first (FR-007, FR-008, SC-004). *@

<div class="recent">
    <h2>Recent activities</h2>

    @if (Activities.Count == 0)
    {
        <p class="recent-empty">Nothing recorded yet.</p>
    }
    else
    {
        <ul class="recent-list">
            @foreach (var activity in Activities)
            {
                <li class="recent-item">
                    <span class="recent-day">@Display.Day(activity.Day)</span>
                    <span class="recent-type">@activity.Type</span>
                    <span class="recent-duration">@Display.Duration(activity.MovingTime)</span>
                    <span class="recent-load">@Display.Points(activity.Load.Points)</span>

                    @* FR-008 as content, not as styling. A difference only a stylesheet expresses
                       is invisible to a screen reader and to anyone who cannot tell the two
                       colours apart (C101). *@
                    <span class="recent-basis recent-basis-@activity.Load.Provenance.ToString().ToLowerInvariant()">
                        @(activity.Load.Provenance == LoadProvenance.Measured ? "measured" : "estimated")
                    </span>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>At most seven, newest first (C84).</summary>
    [Parameter] public IReadOnlyList<RecentActivity> Activities { get; set; } = [];
}
