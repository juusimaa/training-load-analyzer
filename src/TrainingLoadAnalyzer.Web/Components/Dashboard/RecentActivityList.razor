@* The most recent sessions, newest first (008 FR-007, FR-018).

   A plain table. The five values line up down the list because they are columns, which is what a
   grid of list items was approximating before. *@

<section class="recent">
    <h2>Recent activities</h2>

    @if (Activities.Count == 0)
    {
        <p class="recent-empty">Nothing recorded yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Type</th>
                    <th>Moving time</th>
                    <th>Basis</th>
                    <th class="load">Load</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var activity in Activities)
                {
                    var measured = activity.Load.Provenance == LoadProvenance.Measured;

                    <tr class="recent-row">
                        <td class="recent-day num">@Display.Day(activity.Day)</td>
                        <td class="recent-type">@activity.Type</td>
                        <td class="recent-duration num">@Display.Duration(activity.MovingTime)</td>
                        <td>
                            @* FR-018 as content, not as styling. The tag is a container around the
                               word, never a replacement for it: a difference only a stylesheet
                               expresses is invisible to a screen reader and to anyone who cannot
                               tell the two colours apart (C101). *@
                            <span class="tag @(measured ? "tag-accent" : "tag-outline")">
                                @(measured ? "measured" : "estimated")
                            </span>
                        </td>
                        <td class="recent-load num load">@Display.Points(activity.Load.Points)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    /// <summary>At most seven, newest first (C84).</summary>
    [Parameter] public IReadOnlyList<RecentActivity> Activities { get; set; } = [];
}
